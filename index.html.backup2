          <div class="form-group">
            <label>Your Name</label>
            <input id="f-name" type="text" placeholder="Jane Okafor" />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input id="f-email" type="email" placeholder="jane@company.ng" />
          </div>
        </div>
        <div class="form-group">
          <label>Project Type</label>
          <select id="f-type">
            <option value="">Select a service...</option>
            <option>Web Application</option>
            <option>Business Software / ERP</option>
            <option>Payment Integration</option>
            <option>Landing Page / Marketing Site</option>
            <option>IT Consulting</option>
            <option>Something else</option>
          </select>
        </div>
