<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edid.io — Input. Output. Impact.</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --void: #0A0A0F;
      --surface: #13131A;
      --surface2: #1A1A24;
      --indigo: #6C63FF;
      --indigo-dim: #6C63FF22;
      --indigo-mid: #6C63FF66;
      --white: #E8E8F0;
      --muted: #7A7A8C;
      --border: #2A2A38;
      --green: #39FF8A;
    }

    html.light nav {
      background: rgba(244,244,248,0.92);
    }

    html.light {
      --void: #F4F4F8;
      --surface: #FFFFFF;
      --surface2: #EEEEF5;
      --indigo: #5549E8;
      --indigo-dim: #5549E811;
      --indigo-mid: #5549E855;
      --white: #111118;
      --muted: #5A5A72;
      --border: #DDDDE8;
      --green: #1A8A4A;
    }

    .theme-toggle {
      background: none;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--muted);
      cursor: pointer;
      padding: 7px 10px;
      font-size: 1rem;
      line-height: 1;
      transition: border-color 0.2s, color 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .theme-toggle:hover { border-color: var(--indigo); color: var(--indigo); }

    html { scroll-behavior: smooth; }

    body {
      background: var(--void);
      color: var(--white);
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* Grid background */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 60px 60px;
      opacity: 0.25;
      pointer-events: none;
      z-index: 0;
    }

    /* NAV */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 48px;
      border-bottom: 1px solid var(--border);
      background: rgba(var(--nav-bg, 10,10,15), 0.92);
      backdrop-filter: blur(12px);
    }

    .nav-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.4rem;
      color: var(--white);
      text-decoration: none;
      letter-spacing: -0.5px;
    }

    .nav-logo span { color: var(--indigo); }

    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
    }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.875rem;
      font-family: 'Inter', sans-serif;
      transition: color 0.2s;
      letter-spacing: 0.02em;
    }

    .nav-links a:hover { color: var(--white); }

    .nav-cta {
      background: var(--indigo);
      color: #fff !important;
      padding: 8px 20px;
      border-radius: 6px;
      font-weight: 500 !important;
    }

    .nav-cta:hover { background: #7B74FF; color: #fff !important; }

    /* HERO */
    .hero {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 140px 48px 80px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .hero-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      color: var(--indigo);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 32px;
      height: 1px;
      background: var(--indigo);
    }

    .hero-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 1.05;
      letter-spacing: -2px;
      margin-bottom: 16px;
    }

    .hero-title .brand {
      color: var(--white);
    }

    .hero-title .accent {
      color: var(--indigo);
    }

    /* GIT BASH TERMINAL CARD */
    .terminal-card {
      background: #0D1117;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 36px;
      max-width: 560px;
      width: 100%;
      border: 1px solid #30363D;
      box-shadow: 0 8px 32px rgba(0,0,0,0.55);
    }

    .terminal-titlebar {
      background: #161B22;
      padding: 9px 16px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid #30363D;
    }

    .terminal-dots {
      display: flex;
      gap: 6px;
    }

    .dot { width: 12px; height: 12px; border-radius: 50%; }
    .dot-red    { background: #FF5F57; }
    .dot-yellow { background: #FEBC2E; }
    .dot-green  { background: #28C840; }

    .terminal-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: #6E7681;
      flex: 1;
      text-align: center;
    }

    .terminal-body {
      padding: 16px 18px 20px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      line-height: 1.75;
    }

    .t-prev {
      display: flex;
      gap: 0;
      margin-bottom: 2px;
      opacity: 0.45;
      font-size: 0.78rem;
      flex-wrap: wrap;
    }

    .t-user   { color: #79C0FF; }
    .t-at     { color: #6E7681; }
    .t-host   { color: #56D364; }
    .t-path   { color: #79C0FF; }
    .t-branch { color: #F0883E; }
    .t-dollar { color: #6E7681; margin: 0 6px; }
    .t-cmd    { color: #E6EDF3; }
    .t-output { color: #6E7681; font-size: 0.78rem; padding-left: 2px; margin-bottom: 8px; opacity: 0.7; }

    .terminal-active {
      display: block;
      height: 3.5em;
      overflow: hidden;
      line-height: 1.75;
      word-break: break-all;
    }

    .t-prompt-line {
      white-space: nowrap;
      line-height: 1.75;
    }

    .t-typed-line {
      height: 1.8em;
      overflow: hidden;
      line-height: 1.75;
    }

    .t-prompt-wrap {
      white-space: nowrap;
      flex-shrink: 0;
    }

    .t-typed-wrap {
      overflow: hidden;
      height: 2.6em;
      display: block;
    }

    .t-typed { color: #39FF8A; }

    .cursor {
      display: inline-block;
      width: 8px;
      height: 0.95em;
      background: #39FF8A;
      animation: blink 1s step-end infinite;
      vertical-align: text-bottom;
      margin-left: 1px;
      border-radius: 1px;
    }

    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

    .hero-sub {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.7;
      margin-bottom: 48px;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: var(--indigo);
      color: #fff;
      padding: 14px 32px;
      border-radius: 8px;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-primary:hover { background: #7B74FF; transform: translateY(-1px); }

    .btn-ghost {
      border: 1px solid var(--border);
      color: var(--white);
      padding: 14px 32px;
      border-radius: 8px;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 500;
      font-size: 0.95rem;
      text-decoration: none;
      transition: border-color 0.2s, transform 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-ghost:hover { border-color: var(--indigo); transform: translateY(-1px); }

    .hero-scroll {
      position: absolute;
      bottom: 40px;
      left: 48px;
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--muted);
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.1em;
    }

    .scroll-line {
      width: 40px;
      height: 1px;
      background: var(--border);
    }

    /* SECTIONS */
    section {
      position: relative;
      z-index: 1;
      max-width: 1100px;
      margin: 0 auto;
      padding: 100px 48px;
    }

    .section-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--indigo);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-label::before {
      content: '';
      display: inline-block;
      width: 24px;
      height: 1px;
      background: var(--indigo);
    }

    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      letter-spacing: -1px;
      line-height: 1.15;
      margin-bottom: 16px;
    }

    .section-sub {
      color: var(--muted);
      max-width: 500px;
      margin-bottom: 64px;
      font-size: 1rem;
    }

    /* SERVICES */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2px;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }

    .service-card {
      background: var(--surface);
      padding: 36px 32px;
      transition: background 0.2s;
      position: relative;
      overflow: hidden;
    }

    .service-card::after {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 2px;
      background: var(--indigo);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s ease;
    }

    .service-card:hover { background: var(--surface2); }
    .service-card:hover::after { transform: scaleX(1); }

    .service-icon {
      font-size: 1.6rem;
      margin-bottom: 20px;
      display: block;
    }

    .service-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 1.05rem;
      margin-bottom: 10px;
      color: var(--white);
    }

    .service-desc {
      color: var(--muted);
      font-size: 0.875rem;
      line-height: 1.65;
    }

    .service-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 20px;
    }

    .tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      padding: 3px 10px;
      border-radius: 4px;
      border: 1px solid var(--border);
      color: var(--muted);
    }

    /* WORK */
    .work-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .work-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 36px;
      transition: border-color 0.2s, transform 0.2s;
      position: relative;
      overflow: hidden;
    }

    .work-card:hover {
      border-color: var(--indigo-mid);
      transform: translateY(-3px);
    }

    .work-card.featured {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }

    .work-badge {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 4px;
      background: var(--indigo-dim);
      color: var(--indigo);
      border: 1px solid var(--indigo-mid);
      margin-bottom: 20px;
    }

    .work-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 1.25rem;
      margin-bottom: 10px;
      color: var(--white);
    }

    .work-desc {
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.7;
      margin-bottom: 24px;
    }

    .work-metrics {
      display: flex;
      gap: 32px;
    }

    .metric { }

    .metric-val {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.6rem;
      color: var(--indigo);
      line-height: 1;
    }

    .metric-label {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 4px;
    }

    .work-visual {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      height: 220px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      color: var(--indigo);
      overflow: hidden;
      position: relative;
    }

    .code-preview {
      padding: 24px;
      font-size: 0.75rem;
      line-height: 1.8;
      color: var(--muted);
      width: 100%;
    }

    .code-preview .kw { color: var(--indigo); }
    .code-preview .str { color: var(--green); }
    .code-preview .fn { color: #FF9F4A; }

    /* STACK */
    .stack-section {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 60px 48px;
    }

    .stack-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 40px;
    }

    .stack-grid {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    .stack-pill {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 500;
      font-size: 0.875rem;
      padding: 10px 22px;
      border: 1px solid var(--border);
      border-radius: 100px;
      color: var(--white);
      background: var(--surface);
      transition: border-color 0.2s, color 0.2s;
    }

    .stack-pill:hover {
      border-color: var(--indigo);
      color: var(--indigo);
    }

    /* ABOUT */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    .about-handle {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--green);
      margin-bottom: 20px;
    }

    .about-text {
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.8;
      margin-bottom: 16px;
    }

    .about-stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 40px;
    }

    .about-stat {
      padding: 24px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    .about-stat-val {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 2rem;
      color: var(--white);
      line-height: 1;
      margin-bottom: 6px;
    }

    .about-stat-val span { color: var(--indigo); }

    .about-stat-label {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .about-visual {
      position: relative;
    }

    .profile-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 40px;
      text-align: center;
    }

    .profile-avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: var(--indigo-dim);
      border: 2px solid var(--indigo);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 2rem;
      color: var(--indigo);
      margin: 0 auto 20px;
    }

    .profile-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.3rem;
      margin-bottom: 4px;
    }

    .profile-role {
      font-size: 0.85rem;
      color: var(--muted);
      margin-bottom: 24px;
    }

    .profile-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }

    .profile-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      padding: 5px 12px;
      border-radius: 4px;
      border: 1px solid var(--border);
      color: var(--indigo);
      background: var(--indigo-dim);
    }

    .location-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 20px;
    }

    /* CONTACT */
    .contact-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      position: relative;
      z-index: 1;
    }

    .contact-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 100px 48px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: start;
    }

    .contact-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(2rem, 4vw, 3rem);
      letter-spacing: -1px;
      line-height: 1.1;
      margin-bottom: 20px;
    }

    .contact-desc {
      color: var(--muted);
      margin-bottom: 40px;
      font-size: 1rem;
      line-height: 1.7;
    }

    .contact-links {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .contact-link {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: var(--white);
      padding: 16px 20px;
      background: var(--void);
      border: 1px solid var(--border);
      border-radius: 10px;
      transition: border-color 0.2s;
      font-size: 0.9rem;
    }

    .contact-link:hover { border-color: var(--indigo); }

    .contact-link-icon {
      font-size: 1.2rem;
      width: 32px;
      text-align: center;
    }

    .contact-link-label { color: var(--muted); font-size: 0.75rem; display: block; }
    .contact-link-val { font-family: 'Space Grotesk', sans-serif; font-weight: 500; }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      background: var(--void);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 16px;
      color: var(--white);
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
      resize: vertical;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      border-color: var(--indigo);
    }

    .form-group select option { background: var(--surface); }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .submit-btn {
      background: var(--indigo);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 14px 32px;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 8px;
    }

    .submit-btn:hover { background: #7B74FF; transform: translateY(-1px); }

    /* FOOTER */
    footer {
      position: relative;
      z-index: 1;
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border);
    }

    .footer-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--white);
      text-decoration: none;
    }

    .footer-logo span { color: var(--indigo); }

    .footer-copy {
      font-size: 0.8rem;
      color: var(--muted);
      font-family: 'JetBrains Mono', monospace;
    }

    .footer-links {
      display: flex;
      gap: 24px;
    }

    .footer-links a {
      font-size: 0.8rem;
      color: var(--muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-links a:hover { color: var(--white); }

    /* SCROLL ANIMATIONS */
    .fade-up {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* MOBILE */
    @media (max-width: 768px) {
      nav { padding: 16px 24px; }
      .nav-links { display: none; }
      .hero, section { padding-left: 24px; padding-right: 24px; }
      .work-grid, .work-card.featured, .about-grid, .contact-inner { grid-template-columns: 1fr; }
      .work-card.featured { grid-column: span 1; }
      .form-row { grid-template-columns: 1fr; }
      footer { flex-direction: column; gap: 16px; text-align: center; }
      .stack-section { padding: 60px 24px; }

      /* Terminal card mobile fixes */
      .terminal-card {
        max-width: 100%;
        font-size: 0.72rem;
      }

      .terminal-title {
        font-size: 0.6rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 160px;
      }

      .terminal-body {
        padding: 12px 14px 16px;
        font-size: 0.72rem;
      }

      .t-prev {
        font-size: 0.68rem;
      }

      /* Hide hostname on mobile to prevent overflow */
      .t-at, .t-host { display: none; }

      .terminal-active {
        height: 3.5em;
        overflow: hidden;
        font-size: 0.72rem;
        line-height: 1.75;
        word-break: break-all;
      }

      .cursor {
        width: 6px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-up { opacity: 1; transform: none; transition: none; }
      .cursor { animation: none; }
    }
  </style>
</head>
